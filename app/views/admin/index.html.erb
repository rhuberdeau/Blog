<div class="toolbar">
  <span class="ai-buttons">
    <%= link_to "New article", new_article_path, class: "button" %>
    <%= link_to "AI assistant", admin_ai_path, class: "button secondary" %>
  </span>
  <%= button_to "Sign out", session_path, method: :delete, class: "button secondary" %>
</div>

<% [ [ "Unpublished Articles", @articles ], [ "Published Articles", @published_articles ] ].each do |heading, articles| %>
  <h2><%= heading %></h2>
  <table class="admin-table">
    <thead>
      <tr><th>Title</th><th>Summary</th><th><span class="visually-hidden">Actions</span></th></tr>
    </thead>
    <tbody>
      <% articles.each do |article| %>
        <tr>
          <td><%= article.title %></td>
          <td><%= article.summary %></td>
          <td class="actions">
            <%= link_to article.published? ? "View" : "Preview", article, class: "button secondary small" %>
            <%= link_to "Edit", edit_article_path(article), class: "button secondary small" %>
            <% unless article.published? %>
              <%= button_to "Publish", articles_publish_path(article), method: :put, class: "button small", form_class: "inline" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
