<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= full_title(yield(:title)) %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <% if content_for?(:description) %>
  <meta name="description" content="<%= yield(:description) %>">
  <meta property="og:description" content="<%= yield(:description) %>">
  <% end %>
  <meta property="og:title" content="<%= full_title(yield(:title)) %>">
  <meta property="og:type" content="<%= content_for?(:og_type) ? yield(:og_type) : "website" %>">
  <meta property="og:url" content="<%= request.original_url %>" />
  <meta name="msvalidate.01" content="2197772BABCA691F6E16B4FFD6F1CEDD" />
  <meta name="google-site-verification" content="6MojtDLkmdHZbn2f7suKcVZbMEd8w14IPZ5EXu2O4EI" />
  <link href="https://fonts.googleapis.com/css?family=Lora:400,700,400italic,700italic" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css?family=Open+Sans:300italic,400italic,600italic,700italic,800italic,400,300,600,700,800" rel="stylesheet">
  <%# Order matters: the Clean Blog theme overrides Bootstrap 3. %>
  <%= stylesheet_link_tag "bootstrap", "font_awesome", "blog", "data-turbo-track": "reload" %>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= javascript_importmap_tags %>
</head>
<body>
  <%= render 'shared/navigation' %>
  <%= render 'shared/flash' %>

  <%= yield %>
  <%= render 'shared/footer' %>
</body>
</html>
