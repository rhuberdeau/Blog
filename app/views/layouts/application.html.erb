<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= full_title(yield(:title)) %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <% if content_for?(:description) %>
  <meta name="description" content="<%= yield(:description) %>">
  <meta property="og:description" content="<%= yield(:description) %>">
  <% end %>
  <meta property="og:title" content="<%= full_title(yield(:title)) %>">
  <meta property="og:type" content="<%= content_for?(:og_type) ? yield(:og_type) : "website" %>">
  <meta property="og:url" content="<%= request.original_url %>">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png">
  <%= auto_discovery_link_tag :atom, feed_url, title: "Robert Huberdeau" %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= javascript_importmap_tags %>
</head>
<body>
  <%= render "shared/navigation" %>
  <main class="<%= content_for(:main_class) %>">
    <%= render "shared/flash" %>
    <%= yield %>
  </main>
  <%= render "shared/footer" %>
</body>
</html>
