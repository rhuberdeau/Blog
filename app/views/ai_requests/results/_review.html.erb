<% findings = Array(result["findings"]) %>
<p><%= result["overall"] %></p>

<% if findings.empty? %>
  <p class="hint">No problems found.</p>
<% else %>
  <ol class="ai-findings">
    <% findings.each do |finding| %>
      <li class="ai-finding" data-assistant-target="finding">
        <span class="ai-tag ai-tag-<%= finding["category"] %>"><%= finding["category"] %></span>
        <blockquote><%= finding["quote"] %></blockquote>
        <p><strong><%= finding["category"] == "fact-check" || finding["category"] == "structure" ? "Suggestion" : "Change to" %>:</strong>
          <%= finding["suggestion"] %></p>
        <p class="hint"><%= finding["explanation"] %></p>
        <% if context == "editor" %>
          <p class="ai-actions">
            <% unless finding["category"].in?(%w[fact-check structure]) %>
              <button type="button" class="button small"
                      data-action="assistant#apply"
                      data-quote="<%= finding["quote"] %>"
                      data-replacement="<%= finding["suggestion"] %>">Apply</button>
            <% end %>
            <button type="button" class="button secondary small" data-action="assistant#find" data-quote="<%= finding["quote"] %>">Find</button>
            <button type="button" class="button secondary small" data-action="assistant#dismiss">Dismiss</button>
            <span class="ai-note hint" data-role="note"></span>
          </p>
        <% end %>
      </li>
    <% end %>
  </ol>
<% end %>
