<div class="container">
  <div class="row">
    <div class="col-lg-4 col-lg-offset-4 col-md-6 col-md-offset-3">
      <h2>Sign in</h2>
      <%= form_with url: session_path do |form| %>
        <div class="form-group">
          <%= form.label :email_address, "Email" %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
                value: params[:email_address], class: "form-control" %>
        </div>
        <div class="form-group">
          <%= form.label :password %>
          <%= form.password_field :password, required: true, autocomplete: "current-password",
                maxlength: 72, class: "form-control" %>
        </div>
        <%= form.submit "Sign in", class: "btn btn-default" %>
      <% end %>
    </div>
  </div>
</div>
