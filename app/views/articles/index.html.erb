<ul class="post-list">
  <%= render @articles %>
</ul>

<% if @newer_page || @older_page %>
  <nav class="pager" aria-label="Pages">
    <span><%= link_to "← Newer posts", articles_path(page: @newer_page) if @newer_page %></span>
    <span><%= link_to "Older posts →", articles_path(page: @older_page) if @older_page %></span>
  </nav>
<% end %>
