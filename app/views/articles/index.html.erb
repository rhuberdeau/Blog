<%= render "shared/masthead", image: "clean_blog/home-bg.jpg", kind: "site",
      title: "Blog posts", subheading: "and other ramblings" %>

<div class="container px-4 px-lg-5">
  <div class="row gx-4 gx-lg-5 justify-content-center">
    <div class="col-md-10 col-lg-8 col-xl-7">
      <%= render @articles %>

      <div class="d-flex justify-content-between mb-4">
        <div>
          <% if @newer_page %>
            <%= link_to "← Newer posts", articles_path(page: @newer_page), class: "btn btn-primary text-uppercase" %>
          <% end %>
        </div>
        <div>
          <% if @older_page %>
            <%= link_to "Older posts →", articles_path(page: @older_page), class: "btn btn-primary text-uppercase" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
