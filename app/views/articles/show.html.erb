<% content_for :title, @article.title %>
<% content_for :description, @article.summary %>
<% content_for :og_type, "article" %>

<% unless @article.published? %>
  <div class="draft-notice" role="status">
    <span><strong>Draft</strong>: only you can see this page.</span>
    <span class="draft-actions">
      <%= link_to "Edit", edit_article_path(@article), class: "button secondary small" %>
      <%= button_to "Publish", articles_publish_path(@article), method: :put, class: "button small", form_class: "inline" %>
    </span>
  </div>
<% end %>

<article>
  <%= render "articles/article_body", article: @article %>
</article>
