<% content_for :title, @article.title %>
<% content_for :description, @article.summary %>
<% content_for :og_type, "article" %>

<article>
  <header class="article-header">
    <h1><%= @article.title %></h1>
    <p class="dek"><%= @article.summary %></p>
    <%= render "articles/meta", article: @article %>
  </header>

  <div class="prose">
    <%= markdown(@article.body) %>
  </div>
</article>
