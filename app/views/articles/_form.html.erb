<%= form_with model: @article do |f| %>
  <%= render "shared/error_messages", object: f.object %>

  <div class="field">
    <%= f.label :title %>
    <%= f.text_field :title %>
  </div>
  <div class="field">
    <%= f.label :summary %>
    <%= f.text_area :summary, rows: 3 %>
  </div>
  <div class="field">
    <%= f.label :body %>
    <%= f.text_area :body, rows: 25, class: "code" %>
    <p class="hint">Markdown, GitHub-flavoured. Fenced code blocks are highlighted.</p>
  </div>
  <div class="field">
    <%= f.label :tag_names %>
    <%= f.text_field :tag_names %>
    <p class="hint">Comma-separated.</p>
  </div>
  <% if @article.persisted? %>
    <div class="field checkbox">
      <%= f.check_box :published %>
      <%= f.label :published %>
    </div>
  <% end %>

  <%= f.submit "Save" %>
<% end %>
