<%# The editor: fields on the left, a live preview on the right (Write /
    Preview tabs on narrow screens). The preview is rendered by the server
    with the same partial as the article page (preview_controller.js);
    unsaved_changes_controller.js warns before losing edits and saves on
    Ctrl/Cmd+S. %>
<%= form_with model: @article, data: { controller: "unsaved-changes", action: "submit->unsaved-changes#saved",
                                       unsaved_changes_dirty_value: @article.errors.any? } do |f| %>
  <%= render "shared/error_messages", object: f.object %>

  <div class="editor" data-mode="write" data-controller="preview"
       data-preview-url-value="<%= preview_articles_path(id: @article.id) %>">
    <div class="editor-tabs" role="tablist" aria-label="Editor view">
      <button type="button" role="tab" aria-selected="true" class="tab"
              data-preview-target="writeTab" data-action="preview#showWrite">Write</button>
      <button type="button" role="tab" aria-selected="false" class="tab"
              data-preview-target="previewTab" data-action="preview#showPreview">Preview</button>
    </div>

    <div class="editor-write">
      <div class="field">
        <%= f.label :title %>
        <%= f.text_field :title, data: { action: "input->preview#refresh" } %>
      </div>
      <div class="field">
        <%= f.label :summary %>
        <%= f.text_area :summary, rows: 2, data: { action: "input->preview#refresh" } %>
      </div>
      <div class="field">
        <%= f.label :body %>
        <%= f.text_area :body, rows: 24, class: "code", data: { action: "input->preview#refresh", preview_target: "body" } %>
        <p class="hint" data-preview-target="count" aria-live="polite">
          <%= pluralize(@article.word_count, "word") %> · <%= @article.reading_minutes %> min read
        </p>
        <%= render "articles/markdown_help" %>
      </div>
      <div class="field">
        <%= f.label :tag_names %>
        <%= f.text_field :tag_names, data: { action: "input->preview#refresh" } %>
        <p class="hint">Comma-separated.</p>
      </div>
      <% if @article.persisted? %>
        <div class="field checkbox">
          <%= f.check_box :published, data: { action: "change->preview#refresh" } %>
          <%= f.label :published %>
        </div>
      <% end %>

      <p class="form-actions">
        <%= f.submit "Save" %>
        <span class="hint">or press Ctrl+S (⌘S on a Mac)</span>
      </p>
    </div>

    <section class="editor-preview" aria-label="Preview">
      <p class="preview-label">Preview</p>
      <article data-preview-target="output">
        <%= render "articles/preview", article: @article %>
      </article>
    </section>
  </div>
<% end %>
