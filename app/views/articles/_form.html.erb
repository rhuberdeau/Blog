<%= form_with model: @article do |f| %>
  <%= render "shared/error_messages", object: f.object %>

  <div class="mb-3">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :summary, class: "form-label" %>
    <%= f.text_area :summary, class: "form-control", rows: 3 %>
  </div>
  <div class="mb-3">
    <%= f.label :body, class: "form-label" %>
    <%= f.text_area :body, class: "form-control font-monospace", rows: 25 %>
    <div class="form-text">Markdown, GitHub-flavoured. Fenced code blocks are highlighted.</div>
  </div>
  <div class="mb-3">
    <%= f.label :tag_names, class: "form-label" %>
    <%= f.text_field :tag_names, class: "form-control" %>
    <div class="form-text">Comma-separated.</div>
  </div>
  <% if @article.persisted? %>
    <div class="form-check mb-3">
      <%= f.check_box :published, class: "form-check-input" %>
      <%= f.label :published, class: "form-check-label" %>
    </div>
  <% end %>

  <%= f.submit "Save", class: "btn btn-primary" %>
<% end %>
