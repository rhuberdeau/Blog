<%# The editor: fields on the left, a live preview on the right (Write /
    Preview tabs on narrow screens). The preview is rendered by the server
    with the same partial as the article page (preview_controller.js);
    unsaved_changes_controller.js warns before losing edits and saves on
    Ctrl/Cmd+S. %>
<%= form_with model: @article, data: { controller: "unsaved-changes", action: "submit->unsaved-changes#saved",
                                       unsaved_changes_dirty_value: @article.errors.any? } do |f| %>
  <%= render "shared/error_messages", object: f.object %>

  <%# The right-hand side (or a tab on a phone) also holds the AI assistant
      (assistant_controller.js): suggestions are applied only on click. %>
  <div class="editor" data-mode="write" data-controller="preview assistant"
       data-preview-url-value="<%= preview_articles_path(id: @article.id) %>"
       data-assistant-url-value="<%= ai_requests_path(context: "editor") %>"
       data-assistant-article-id-value="<%= @article.id %>">
    <div class="editor-tabs" role="tablist" aria-label="Editor view">
      <button type="button" role="tab" aria-selected="true" class="tab tab-write"
              data-preview-target="writeTab" data-action="preview#showWrite">Write</button>
      <button type="button" role="tab" aria-selected="false" class="tab"
              data-preview-target="previewTab" data-action="preview#showPreview">Preview</button>
      <button type="button" role="tab" aria-selected="false" class="tab"
              data-preview-target="assistantTab" data-action="preview#showAssistant">Assistant</button>
    </div>

    <div class="editor-write">
      <div class="field">
        <%= f.label :title %>
        <%# Prose fields: the browser's own spell checker (and Edge's grammar
            checker) runs on them; autocapitalize/autocorrect help on phones. %>
        <%= f.text_field :title, spellcheck: true, lang: "en", autocorrect: "on",
              data: { action: "input->preview#refresh" } %>
      </div>
      <div class="field">
        <%= f.label :summary %>
        <%= f.text_area :summary, rows: 2, spellcheck: true, lang: "en", autocapitalize: "sentences", autocorrect: "on",
              data: { action: "input->preview#refresh" } %>
      </div>
      <div class="field">
        <%= f.label :body %>
        <%= f.text_area :body, rows: 24, class: "code", spellcheck: true, lang: "en", autocapitalize: "sentences", autocorrect: "on",
              data: { action: "input->preview#refresh", preview_target: "body" } %>
        <p class="hint" data-preview-target="count" aria-live="polite">
          <%= pluralize(@article.word_count, "word") %> · <%= @article.reading_minutes %> min read
        </p>
        <%= render "articles/markdown_help" %>
      </div>
      <div class="field">
        <%= f.label :tag_names %>
        <%# Tags are short labels, not prose: don't flag them as misspelled. %>
        <%= f.text_field :tag_names, spellcheck: false, autocapitalize: "none", autocorrect: "off",
              data: { action: "input->preview#refresh" } %>
        <p class="hint">Comma-separated.</p>
      </div>
      <% if @article.persisted? %>
        <div class="field checkbox">
          <%= f.check_box :published, data: { action: "change->preview#refresh" } %>
          <%= f.label :published %>
        </div>
      <% end %>

      <p class="form-actions">
        <%= f.submit "Save" %>
        <span class="hint">or press Ctrl+S (⌘S on a Mac)</span>
      </p>
    </div>

    <section class="editor-preview" aria-label="Preview">
      <p class="preview-label">Preview</p>
      <article data-preview-target="output">
        <%= render "articles/preview", article: @article %>
      </article>
    </section>

    <section class="editor-assistant" aria-label="Assistant">
      <p class="preview-label">Assistant</p>
      <%= render "ai_requests/spend" %>
      <p class="hint">Sends the draft as currently typed to Claude (Anthropic). Nothing changes until you click Apply or Use.</p>
      <p class="ai-buttons">
        <button type="button" class="button" data-kind="review" data-action="assistant#request">Review draft</button>
        <button type="button" class="button secondary" data-kind="metadata" data-action="assistant#request">Suggest titles, summary &amp; tags</button>
      </p>
      <div class="ai-results" data-assistant-target="results" aria-live="polite"></div>
    </section>
  </div>
<% end %>
