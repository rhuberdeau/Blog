<header class="site-header">
  <%= link_to "Robert Huberdeau", root_path, class: "site-name" %>
  <nav aria-label="Main">
    <ul>
      <li><%= link_to "Home", root_path, aria: { current: ("page" if current_page?(root_path)) } %></li>
      <li><%= link_to "About", about_path, aria: { current: ("page" if current_page?(about_path)) } %></li>
      <% if authenticated? %>
        <li><%= link_to "Admin", admin_path, aria: { current: ("page" if current_page?(admin_path)) } %></li>
      <% end %>
    </ul>
  </nav>
</header>
