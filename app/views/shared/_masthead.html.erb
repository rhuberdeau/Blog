<%# The theme's full-width image header. kind is "site", "post" or "page"
    (the theme styles each heading differently); meta is an optional line
    under a post's subheading. %>
<% kind = local_assigns.fetch(:kind, "page") %>
<header class="masthead" style="background-image: url('<%= asset_path(image) %>')">
  <div class="container position-relative px-4 px-lg-5">
    <div class="row gx-4 gx-lg-5 justify-content-center">
      <div class="col-md-10 col-lg-8 col-xl-7">
        <div class="<%= kind %>-heading">
          <h1><%= title %></h1>
          <% if local_assigns[:subheading].present? %>
            <%= tag.public_send(kind == "post" ? :h2 : :span, subheading, class: "subheading") %>
          <% end %>
          <% if local_assigns[:meta].present? %>
            <span class="meta"><%= meta %></span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</header>
