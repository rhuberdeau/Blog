<% if notice.present? || alert.present? %>
  <div class="container flash-messages">
    <% if notice.present? %><div class="alert alert-info" role="status"><%= notice %></div><% end %>
    <% if alert.present? %><div class="alert alert-danger" role="alert"><%= alert %></div><% end %>
  </div>
<% end %>
