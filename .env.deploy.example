# Copy to .env.deploy (gitignored) and fill in. Read by the `deploy` compose
# service; config/deploy.yml and .kamal/secrets use these.

# Where the blog runs
BLOG_SERVER_IP=          # Lightsail static IP
BLOG_HOST=               # e.g. blog.example.com (DNS A record -> BLOG_SERVER_IP)
CONTACT_EMAIL=           # optional, shown on the About page

# GitHub token with write:packages (pushes the image to ghcr.io)
KAMAL_REGISTRY_PASSWORD=

# App secrets
SECRET_KEY_BASE=         # bin/rails secret
ADMIN_EMAIL=
ADMIN_PASSWORD=          # the author account, created on first boot

# Litestream backups (IAM user limited to this bucket)
LITESTREAM_BUCKET=
LITESTREAM_REGION=us-east-1
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
