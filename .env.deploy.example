# Copy to .env.deploy (gitignored) and fill in. Read by the `deploy` compose
# service; config/deploy.yml and .kamal/secrets use these.
# Keep comments on their own lines: docker's env-file parser would take an
# inline comment as part of the value.

# Lightsail static IP
BLOG_SERVER_IP=
# Comma-separated names the blog serves, canonical first; every name needs a
# DNS A record pointing at BLOG_SERVER_IP
BLOG_HOSTS=
# Optional, shown on the About page
CONTACT_EMAIL=

# GitHub token with write:packages (pushes the image to ghcr.io)
KAMAL_REGISTRY_PASSWORD=

# Signs session cookies: generate once (bin/rails secret) and keep it
SECRET_KEY_BASE=
# The author account, created on first boot
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Litestream backups (IAM user limited to this bucket)
LITESTREAM_BUCKET=
LITESTREAM_REGION=us-east-1
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
