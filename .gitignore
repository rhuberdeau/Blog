# See https://help.github.com/articles/ignoring-files for more about ignoring files.

/.bundle
/.env*
!/.env.deploy.example

/log/*
!/log/.keep
/tmp/*
!/tmp/.keep

# SQLite databases (a Docker volume in dev and production).
/storage/*
!/storage/.keep

/public/assets

/config/master.key
/config/credentials/*.key
